{
  "name": "scriptless-social-sharing",
  "description": "Scriptless Social Sharing",
  "version": "3.3.1",
  "private": true,
  "license": "GPL-2.0+",
  "scripts": {
    "build": "wp-scripts build --source-path=assets/src",
    "dev": "wp-scripts start --source-path=assets/src",
    "translate": "wp i18n make-pot . languages/scriptless-social-sharing.pot --exclude=assets/build,build,node_modules,vendor",
    "package": "grunt clean && npm run translate && npm run build && grunt copy && grunt compress"
  },
  "devDependencies": {
    "@wordpress/scripts": "^32.0.0",
    "grunt": "^1.6.1",
    "grunt-contrib-clean": "^2.0.1",
    "grunt-contrib-compress": "^2.0.0",
    "grunt-contrib-copy": "^1.0.0",
    "load-grunt-tasks": "^5.1.0",
    "webpack-remove-empty-scripts": "^1.1.1"
  },
  "browserslist": [
    "extends @wordpress/browserslist-config"
  ]
}
