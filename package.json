{
  "name": "scriptless-social-sharing",
  "description": "Scriptless Social Sharing",
  "version": "3.3.1",
  "private": true,
  "license": "GPL-2.0+",
  "scripts": {
    "build": "wp-scripts build",
    "dev": "wp-scripts start",
    "translate": "wp i18n make-pot . languages/scriptless-social-sharing.pot --exclude=assets,build,node_modules,vendor",
    "package": "grunt clean && npm run translate && npm run build && grunt copy && grunt compress"
  },
  "devDependencies": {
    "@wordpress/scripts": "^32.0.0",
    "grunt": "^1.6.1",
    "grunt-contrib-clean": "^2.0.1",
    "grunt-contrib-compress": "^2.0.0",
    "grunt-contrib-copy": "^1.0.0",
    "load-grunt-tasks": "^5.1.0",
    "mini-css-extract-plugin": "^2.7.6",
    "path": "^0.12.7",
    "webpack-fix-style-only-entries": "^0.6.1"
  },
  "browserslist": [
    "extends @wordpress/browserslist-config"
  ]
}
